root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,yml,yaml,css,scss,html}]
indent_size = 2

[*.md]
# Trailing whitespace is meaningful in Markdown line breaks, and the
# specification's worked examples must not be reformatted.
trim_trailing_whitespace = false

[all_lock.md]
# The master record is append-only. No editor may reformat it.
trim_trailing_whitespace = false
insert_final_newline = false

[Makefile]
indent_style = tab
