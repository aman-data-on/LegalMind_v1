# ─── Secrets ────────────────────────────────────────────────────────────────
# S-6: secrets outside source control. .env.example is the only tracked variant.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtualenvs
.venv/
venv/
env/
ENV/

