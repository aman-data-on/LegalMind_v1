.mypy_cache/
.dmypy.json
.ruff_cache/
.pyre/
.pytype/

# ─── Node / frontend (Step 39 stack: Next.js + TypeScript) ──────────────────
node_modules/
.next/
.next-staging/
.next-previous/
# The browser suite's own build target — kept off `.next` so a suite run can
# never rewrite what the live frontend service is serving (2026-09-02).
.next-e2e/
.next-usertest/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─── Legal source material — NEVER commit ───────────────────────────────────
# Owner ruling 2026-08-19: the supplied legal documents live INSIDE the project
# at legal-docs/ for convenience, but NEVER enter version control (locked 54.6).
# tests/test_source_material.py verifies this rule is present and nothing under
# the directory is tracked.
legal-docs/
# Step 54: real counterparty contracts never enter the repository.
# Step 55: real contracts never leave production.
# Golden-corpus fixtures are synthetic or cleared text only.
*.pdf
*.docx
*.doc
!docs/**/*.pdf
# An ARCHIVE walks the blocked types straight past an extension rule. Found
# 2026-08-18, when a zip of seven statute PDFs landed in the repository root and
# neither this file nor CI job 8 objected.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
uploads/
storage/
object-store/
corpus/normative/

# ─── Local databases / dumps ────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# ─── Editors ────────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.\#*
\#*\#

# ─── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ─── Logs / runtime ─────────────────────────────────────────────────────────
*.log
logs/
celerybeat-schedule
celerybeat.pid
*.pid

# ─── Browser-suite artefacts (Playwright, Step 39) ──────────────────────────
# `e2e/.auth/` holds real session cookies for the synthetic e2e accounts, and
# `.fixture.json` holds their credentials. Neither is a production secret (55.3:
# development is synthetic data only) and neither belongs in the repository.
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/e2e/.auth/
frontend/e2e/.fixture.json
frontend/e2e/.fixture-snapshot.json
# Generated STRUCTURAL document, the e2e object store and verification logs. The
# document is also caught by `*.docx` above, which CI job 8 enforces separately.
backend/.e2e/
