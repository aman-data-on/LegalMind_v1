# Failure alerts (backend/tools/alert_failures.py): every 10 minutes, the failures the code
# already marks in the API, worker and benchmark journals, and any failed legalmind-* unit,
# sent once per kind (repeated at most every 6 h) by EMAIL to LEGALMIND_ALERT_EMAIL_TO through
# LEGALMIND_ALERT_SMTP_HOST/_PORT/_USER/_PASSWORD (STARTTLS; owner 2026-10-30), and/or to a
# Slack webhook (LEGALMIND_ALERT_WEBHOOK_URL), all in /root/.legalmind.env. Content-free:
# event names and counts only. Neither set: the message goes to this unit's journal only.
#
# Install with the timer:
#   sudo cp ops/production/legalmind-alerts.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now legalmind-alerts.timer
# Read:  journalctl -u legalmind-alerts -n 20

[Unit]
Description=LegalMind failure alerts

[Service]
Type=oneshot
Nice=10
TimeoutStartSec=60
WorkingDirectory=/root/Legalmind.v1/backend
EnvironmentFile=/root/.legalmind.env
ExecStart=/usr/bin/python3 -m tools.alert_failures
StandardOutput=journal
StandardError=journal
SyslogIdentifier=legalmind-alerts
