{
  "name": "legalmind-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "LegalMind V1 frontend \u2014 locked Step 52. Next.js + TypeScript (Step 39). shadcn/ui + Tailwind approved for incremental adoption (owner, 2026-09-10) \u2014 see CLAUDE.md \u00a7 UI and UX work for binding terms; no other technology without rule 19 approval.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && npm run check:terms && npm run lint:hooks",
    "lint:hooks": "eslint src/components/diff-talk src/app/dashboard/diff",
    "check:terms": "node scripts/check-forbidden-terms.mjs",
    "test": "vitest run",
    "test:all": "npm run typecheck && npm run check:terms && npm run test",
    "test:e2e": "playwright test",
    "design-qa": "playwright test e2e/visual.spec.ts",
    "prebuild": "node scripts/guard-build-target.mjs",
    "deploy": "bash scripts/deploy-frontend.sh"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.22",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-select": "^2.3.7",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-diff-viewer-continued": "4.4.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "zod": "4.6.6",
    "caniuse-lite": "1.0.30001809",
    "baseline-browser-mapping": "2.11.14"
  }
